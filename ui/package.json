{
	"name": "pacod-bench-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"authz:gen": "pacod-id-authz gen ../authz/bench.yaml --out src/lib/authz.generated.ts && prettier --write src/lib/authz.generated.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@lucide/svelte": "^1.52.0",
		"@pacod/id-authz": "file:vendor/pacod-id-authz-0.1.0.tgz",
		"@pacod/ui": "file:vendor/pacod-ui-0.1.0.tgz",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@pacod/id-client": "file:vendor/pacod-id-client-0.1.0.tgz",
		"@pacod/id-sveltekit": "file:vendor/pacod-id-sveltekit-0.1.0.tgz",
		"chart.js": "^4.5.1"
	}
}
