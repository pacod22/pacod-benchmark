# pacod-benchmark's own stack (`make up`): copy to .env with scripts/init-env.sh, which fills in
# every secret. `make dev-up` needs no .env but for BENCH_GW_ADMIN_URL and BENCH_GW_ADMIN_TOKEN.

BENCH_VERSION=0.1.0
BENCH_REGISTRY=

# Addresses as browsers reach them: the UI (Caddy's site) and pacod-id (the issuer).
BENCH_SITE=http://localhost:18380
BENCH_ORIGIN=http://localhost:18380
BENCH_ID_ISSUER=http://127.0.0.1:18370

# Secrets (scripts/init-env.sh).
POSTGRES_PASSWORD=
BENCH_DB_PASSWORD=
PID_DB_PASSWORD=
PID_KEK=
PID_TOKEN_PEPPER=
BENCH_ID_UI_SECRET=
BENCH_ID_SERVICE_SECRET=
BENCH_UI_SESSION_SECRET=
# Seals the admin tokens of gateways added through the UI (docs/runbook.md, section 3). Keep it
# outside the database's backups: with both, the tokens open.
BENCH_KEK=
ID_ADMIN_EMAIL=admin@pacod-bench.test
ID_ADMIN_PASSWORD=

# A gateway the benchmark manages from the configuration: its management API, a platform-admin
# token of it (docs/runbook.md, section 3), the mock as that gateway reaches it, and the
# console's address for links. Leave the URL empty to add gateways through the UI instead.
BENCH_GW_ADMIN_URL=
BENCH_GW_ADMIN_TOKEN=
BENCH_LOAD_MOCK_URL=http://gw-load-mock:9000
BENCH_GW_CONSOLE_URL=
BENCH_GW_DECLARED={"layout": "single"}
# The gateway of this stack, as the UI offers it when a gateway is added there.
BENCH_GW_INTERNAL_ADMIN_URL=http://host.docker.internal:18081
BENCH_GW_INTERNAL_MOCK_URL=http://gw-load-mock:9000
BENCH_GW_INTERNAL_DATA_PLANE=

# The load agents: the stack's own (bench-load-agent) and any on other machines, the token they
# share (LOAD_AGENT_TOKEN of each; the same as pacod-gw's TESTER_LOAD_TOKEN when the tester uses
# them too), where they stand, and what the stack's own agent calls by default.
BENCH_AGENTS=local=http://bench-load-agent:8096
BENCH_AGENT_PLACEMENT=local=same_host
BENCH_AGENT_TOKEN=
BENCH_AGENT_TARGET_URL=http://host.docker.internal:18080
BENCH_BASELINE_MOCK_URL=http://bench-load-mock:9000
BENCH_LITE_KEY=

BENCH_LOG_FORMAT=json
